{
  "name": "proyecto-matematicas-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Back-End",
    "Front-End"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "dev:front": "npm run dev --workspace=frontend",
    "dev:back": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:all": "npm run build --workspaces --if-present",
    "build:front": "npm run build --workspace=frontend",
    "build:back": "npm run build --workspace=backend",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}